{
  "openapi": "3.1.0",
  "info": {
    "title": "The Estimator preview APIs",
    "version": "1.1.0",
    "description": "Versioned wire contracts for the Next.js preview BFF, Python brief analysis service, and Go effort estimator. These contracts describe the current preview flow and do not imply production client-data persistence or hosted AI availability."
  },
  "paths": {
    "/health/live": {
      "servers": [
        { "url": "http://127.0.0.1:8001", "description": "Default local address for the Python brief service" },
        { "url": "http://127.0.0.1:8002", "description": "Default local address for the Go estimator" }
      ],
      "get": {
        "operationId": "checkServiceLiveness",
        "summary": "Check whether a service process is alive",
        "description": "Both the Python brief service and Go estimator expose this path on their own service address.",
        "responses": {
          "200": {
            "description": "The service process is alive.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthLive" } } }
          }
        }
      }
    },
    "/health/ready": {
      "servers": [
        { "url": "http://127.0.0.1:8001", "description": "Default local address for the Python brief service" },
        { "url": "http://127.0.0.1:8002", "description": "Default local address for the Go estimator" }
      ],
      "get": {
        "operationId": "checkServiceReadiness",
        "summary": "Check whether a service can accept requests",
        "description": "The Python brief service reports its parser; the Go estimator reports its engine version.",
        "responses": {
          "200": {
            "description": "Service-specific readiness information.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthReady" } } }
          }
        }
      }
    },
    "/api/v1/preview": {
      "post": {
        "operationId": "createPreview",
        "summary": "Create a brief analysis and effort estimate preview",
        "description": "Next.js BFF route. Accepts at most 100,000 request bytes and a brief of 30 to 20,000 characters. The sample parser is available; the AI parser is recognized but returns 503 while AI is unconfigured.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PreviewRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Brief scope and deterministic effort estimate.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PreviewResponse" }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, a non-object body, an invalid brief, or an unsupported parser value.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BFFError" } } }
          },
          "413": {
            "description": "Request body exceeds 100,000 bytes.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BFFError" } } }
          },
          "422": {
            "description": "A downstream service rejects the brief or estimate request.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BFFError" } } }
          },
          "503": {
            "description": "AI parsing is unconfigured or a preview service is unavailable or times out.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BFFError" } } }
          }
        }
      }
    },
    "/v1/briefs/analyze": {
      "post": {
        "operationId": "analyzeBrief",
        "summary": "Extract a source-linked integration scope from a brief",
        "description": "Python FastAPI endpoint. The request model requires a brief between 30 and 20,000 characters. The parser field defaults to sample; any parser value other than sample returns 503.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BriefAnalyzeRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extracted scope and initial answers.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Scope" } } }
          },
          "422": {
            "description": "Invalid request fields or an unsupported data-import/integration brief.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PythonError" } } }
          },
          "503": {
            "description": "Requested parser is not configured; choose sample.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PythonError" } } }
          }
        }
      }
    },
    "/v1/estimates": {
      "post": {
        "operationId": "createEstimate",
        "summary": "Estimate integration effort from a reviewed scope",
        "description": "Go estimator endpoint. The request body is limited to 1 MiB. Go JSON decoding rejects unknown object fields. historyPolicy defaults to demo and supports demo or recorded.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EstimateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task-level effort, planning range, assumptions, matched examples, and provenance.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Estimate" } } }
          },
          "400": {
            "description": "Malformed JSON, unknown JSON fields, or a request body that cannot be decoded.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GoError" } } }
          },
          "422": {
            "description": "Invalid answers, history policy, requested requirement category, or exclusion category.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GoError" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthLive": {
        "type": "object",
        "properties": { "status": { "const": "ok" } },
        "required": ["status"],
        "additionalProperties": false
      },
      "HealthReady": {
        "oneOf": [
          { "$ref": "#/components/schemas/BriefServiceReady" },
          { "$ref": "#/components/schemas/EstimatorServiceReady" }
        ]
      },
      "BriefServiceReady": {
        "type": "object",
        "properties": {
          "status": { "const": "ready" },
          "parser": { "const": "sample" }
        },
        "required": ["status", "parser"],
        "additionalProperties": false
      },
      "EstimatorServiceReady": {
        "type": "object",
        "properties": {
          "status": { "const": "ready" },
          "engine": { "const": "integration-effort/2.0" }
        },
        "required": ["status", "engine"],
        "additionalProperties": false
      },
      "PreviewRequest": {
        "type": "object",
        "properties": {
          "brief": { "$ref": "#/components/schemas/Brief" },
          "parser": {
            "type": "string",
            "enum": ["sample", "ai"],
            "default": "sample",
            "description": "ai is recognized by the BFF but returns 503 until hosted AI is configured."
          }
        },
        "required": ["brief"],
        "additionalProperties": true
      },
      "BriefAnalyzeRequest": {
        "type": "object",
        "properties": {
          "brief": { "$ref": "#/components/schemas/Brief" },
          "parser": {
            "type": "string",
            "default": "sample",
            "description": "Only sample is implemented; other strings return HTTP 503."
          }
        },
        "required": ["brief"],
        "additionalProperties": true
      },
      "Brief": {
        "type": "string",
        "minLength": 30,
        "maxLength": 20000
      },
      "EstimateRequest": {
        "type": "object",
        "properties": {
          "scope": { "$ref": "#/components/schemas/EstimateScopeInput" },
          "answers": { "$ref": "#/components/schemas/Answers" },
          "excluded": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Category" },
            "default": []
          },
          "historyPolicy": {
            "type": "string",
            "enum": ["demo", "recorded"],
            "default": "demo"
          }
        },
        "required": ["answers"],
        "additionalProperties": false
      },
      "EstimateScopeInput": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "requirements": { "type": "array", "items": { "$ref": "#/components/schemas/ScopeRequirementInput" } },
          "initialAnswers": { "$ref": "#/components/schemas/ScopeInitialAnswers" },
          "risks": { "type": "array", "items": { "type": "string" } },
          "parser": { "type": "string" }
        },
        "additionalProperties": false
      },
      "ScopeRequirementInput": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Category" },
          "title": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "ScopeInitialAnswers": {
        "type": "object",
        "properties": {
          "direction": { "type": "string" },
          "api": { "type": "string" },
          "quality": { "type": "string" },
          "volume": { "type": "string" },
          "mapping": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Answers": {
        "type": "object",
        "properties": {
          "direction": { "type": "string", "enum": ["unknown", "one-way", "two-way"] },
          "api": { "type": "string", "enum": ["unknown", "documented", "custom"] },
          "quality": { "type": "string", "enum": ["unknown", "clean", "mixed"] },
          "volume": { "type": "string", "enum": ["unknown", "small", "medium", "large"] },
          "mapping": { "type": "string", "enum": ["unknown", "standard", "custom"] }
        },
        "required": ["direction", "api", "quality", "volume", "mapping"],
        "additionalProperties": false
      },
      "Category": {
        "type": "string",
        "enum": ["discovery", "authentication", "mapping", "import", "sync", "deduplication", "testing", "handover"]
      },
      "Requirement": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Category" },
          "title": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["id", "title", "evidence"],
        "additionalProperties": false
      },
      "Scope": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "requirements": { "type": "array", "items": { "$ref": "#/components/schemas/Requirement" } },
          "initialAnswers": { "$ref": "#/components/schemas/Answers" },
          "risks": { "type": "array", "items": { "type": "string" } },
          "parser": { "type": "string" }
        },
        "required": ["summary", "requirements", "initialAnswers", "risks", "parser"],
        "additionalProperties": false
      },
      "PreviewResponse": {
        "type": "object",
        "properties": {
          "scope": { "$ref": "#/components/schemas/Scope" },
          "estimate": { "$ref": "#/components/schemas/Estimate" }
        },
        "required": ["scope", "estimate"],
        "additionalProperties": false
      },
      "Estimate": {
        "type": "object",
        "properties": {
          "tasks": { "type": "array", "items": { "$ref": "#/components/schemas/TaskEstimate" } },
          "low": { "type": "integer" },
          "high": { "type": "integer" },
          "hours": { "type": "number" },
          "baseHours": { "type": "number" },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "assumptions": { "type": "array", "items": { "type": "string" } },
          "references": { "type": "array", "items": { "$ref": "#/components/schemas/Reference" } },
          "provenance": { "$ref": "#/components/schemas/Provenance" }
        },
        "required": ["tasks", "low", "high", "hours", "baseHours", "blockers", "assumptions", "references", "provenance"],
        "additionalProperties": false
      },
      "TaskEstimate": {
        "type": "object",
        "properties": {
          "category": { "$ref": "#/components/schemas/Category" },
          "label": { "type": "string" },
          "base": { "type": "number" },
          "factor": { "type": "number" },
          "hours": { "type": "number" },
          "low": { "type": "integer" },
          "high": { "type": "integer" },
          "observations": { "type": "integer" },
          "referenceIds": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["category", "label", "base", "factor", "hours", "low", "high", "observations", "referenceIds"],
        "additionalProperties": false
      },
      "Reference": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "synthetic": { "type": "boolean" },
          "score": { "type": "number" },
          "hours": { "type": "number" },
          "knownKeys": { "type": "array", "items": { "$ref": "#/components/schemas/AnswerKey" } },
          "matchedKeys": { "type": "array", "items": { "$ref": "#/components/schemas/AnswerKey" } }
        },
        "required": ["id", "name", "synthetic", "score", "hours", "knownKeys", "matchedKeys"],
        "additionalProperties": false
      },
      "AnswerKey": {
        "type": "string",
        "enum": ["direction", "api", "quality", "volume", "mapping"]
      },
      "Provenance": {
        "type": "object",
        "properties": {
          "engineVersion": { "type": "string" },
          "historyPolicy": { "type": "string", "enum": ["demo", "recorded"] },
          "similarityThreshold": { "type": "number" },
          "priorObservations": { "type": "integer" },
          "ratioBounds": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "driverWeights": {
            "type": "object",
            "properties": {
              "direction": { "type": "number" },
              "api": { "type": "number" },
              "quality": { "type": "number" },
              "volume": { "type": "number" },
              "mapping": { "type": "number" }
            },
            "required": ["direction", "api", "quality", "volume", "mapping"],
            "additionalProperties": false
          },
          "referenceIds": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["engineVersion", "historyPolicy", "similarityThreshold", "priorObservations", "ratioBounds", "driverWeights", "referenceIds"],
        "additionalProperties": false
      },
      "BFFError": {
        "type": "object",
        "properties": {
          "error": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "$ref": "#/components/schemas/ValidationError" } }
            ]
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "GoError": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"],
        "additionalProperties": false
      },
      "PythonError": {
        "type": "object",
        "properties": {
          "detail": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "$ref": "#/components/schemas/ValidationError" } }
            ]
          }
        },
        "required": ["detail"],
        "additionalProperties": true
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "loc": { "type": "array", "items": { "type": ["string", "integer"] } },
          "msg": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["loc", "msg", "type"],
        "additionalProperties": true
      }
    }
  }
}
