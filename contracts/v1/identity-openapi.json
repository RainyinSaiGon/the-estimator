{
  "openapi": "3.1.0",
  "info": {
    "title": "The Estimator first-party identity API",
    "version": "1.1.0",
    "description": "Internal service contract for the Next.js BFF and trusted services. It is not a public browser API. The service owns local accounts and revocable sessions; it does not store estimate records. Session renewal rotates the opaque token and preserves a 30-day absolute session-family lifetime. Account registration creates an unverified account; email must be verified before the BFF may issue a private-record service token. Verification and password recovery use one-time expiring tokens and an internal mailer. With IDENTITY_EMAIL_MODE=disabled, email actions return a generic unavailable response and private-record access remains blocked. This v1.1 lifecycle contract is contract-first; its new email routes and verified-account behavior are not implemented by the current service yet."
  },
  "servers": [
    {
      "url": "http://identity:8003",
      "description": "Internal Docker Compose address; never publish this service directly."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "identityLiveness",
        "summary": "Check whether the identity process is alive",
        "responses": {
          "200": {
            "description": "The service process is alive.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Live" }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "identityReadiness",
        "summary": "Check identity storage readiness",
        "responses": {
          "200": {
            "description": "The identity database is reachable.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ready" }
              }
            }
          },
          "503": {
            "description": "The identity database is not ready."
          }
        }
      }
    },
    "/v1/accounts": {
      "post": {
        "operationId": "createAccount",
        "summary": "Create an account and its first session",
        "security": [{ "serviceSecret": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAccount" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "An unverified account and its first session were created. The BFF requests email verification; private-record access remains blocked until verification completes.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionCreated" }
              }
            }
          },
          "400": { "description": "The account request is invalid." },
          "409": { "description": "The account could not be created with these details." },
          "503": { "description": "Identity storage is temporarily unavailable." }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Verify account credentials and create a session",
        "security": [{ "serviceSecret": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSession" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The session was created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionCreated" }
              }
            }
          },
          "400": { "description": "The request is invalid." },
          "401": { "description": "Credentials are invalid." },
          "429": { "description": "Sign-in attempts are temporarily limited." },
          "503": { "description": "Identity storage is temporarily unavailable." }
        }
      }
    },
    "/v1/session": {
      "get": {
        "operationId": "inspectSession",
        "summary": "Resolve a session to its stable account identity",
        "description": "Only the BFF or another trusted internal service may call this operation. It is the server-side identity check used before accessing owner-scoped resources.",
        "security": [{ "serviceSecret": [], "sessionBearer": [] }],
        "responses": {
          "200": {
            "description": "The session is valid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "401": { "description": "The session is missing, expired, or revoked." },
          "503": { "description": "Identity storage is temporarily unavailable." }
        }
      },
      "delete": {
        "operationId": "revokeSession",
        "summary": "Revoke the current session",
        "security": [{ "serviceSecret": [], "sessionBearer": [] }],
        "responses": {
          "204": { "description": "The session was revoked or was already absent." },
          "503": { "description": "Identity storage is temporarily unavailable." }
        }
      }
    },
    "/v1/session/renew": {
      "post": {
        "operationId": "renewSession",
        "summary": "Rotate the current session token",
        "description": "Revokes the current token and creates a replacement with a renewed idle expiry, bounded by the original 30-day absolute session-family expiry.",
        "security": [{ "serviceSecret": [], "sessionBearer": [] }],
        "responses": {
          "200": {
            "description": "The session was rotated. The new token must remain server-side and be placed only in the protected browser cookie by the BFF.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionCreated" }
              }
            }
          },
          "401": { "description": "The session is missing, expired, or revoked." },
          "500": { "description": "A replacement session token could not be generated." },
          "503": { "description": "Identity storage is temporarily unavailable." }
        }
      }
    },
    "/v1/email-verifications": {
      "post": {
        "operationId": "requestEmailVerification",
        "summary": "Send a verification message to the signed-in account",
        "description": "The service derives the destination from the authenticated account; callers cannot supply another address. Requests are throttled. The response does not include a verification token.",
        "security": [{ "serviceSecret": [], "sessionBearer": [] }],
        "responses": {
          "202": { "description": "The request was accepted for delivery." },
          "401": { "description": "The account session is missing, expired, or revoked." },
          "429": { "description": "Verification requests are temporarily limited." },
          "503": { "description": "Email delivery is unavailable." }
        }
      }
    },
    "/v1/email-verifications/complete": {
      "post": {
        "operationId": "completeEmailVerification",
        "summary": "Verify an account email using a single-use token",
        "security": [{ "serviceSecret": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CompleteEmailVerification" }
            }
          }
        },
        "responses": {
          "204": { "description": "The token was valid and the account email is verified." },
          "400": { "description": "The token is invalid, expired, or already used." },
          "503": { "description": "Identity storage is temporarily unavailable." }
        }
      }
    },
    "/v1/password-recovery-requests": {
      "post": {
        "operationId": "requestPasswordRecovery",
        "summary": "Request a password recovery message",
        "description": "For a well-formed address, return the same 202 response whether the account exists or has a verified email. Apply account and request throttles without disclosing account state. When email delivery is disabled, return the same generic 503 for every address.",
        "security": [{ "serviceSecret": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordRecoveryRequest" }
            }
          }
        },
        "responses": {
          "202": { "description": "The request was accepted; account existence is not disclosed." },
          "400": { "description": "The request is malformed." },
          "429": { "description": "Recovery requests are temporarily limited." },
          "503": { "description": "Email delivery is unavailable; account existence is not disclosed." }
        }
      }
    },
    "/v1/password-recoveries": {
      "post": {
        "operationId": "completePasswordRecovery",
        "summary": "Replace a password using a single-use recovery token",
        "description": "A successful reset consumes the token and revokes every active session for the account in the same transaction.",
        "security": [{ "serviceSecret": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CompletePasswordRecovery" }
            }
          }
        },
        "responses": {
          "204": { "description": "The password was replaced and existing sessions were revoked." },
          "400": { "description": "The token is invalid, expired, or already used, or the new password is invalid." },
          "429": { "description": "Recovery attempts are temporarily limited." },
          "503": { "description": "Identity storage is temporarily unavailable." }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Identity-BFF-Secret"
      },
      "sessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque random token"
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accountId", "email", "displayName", "emailVerified"],
        "properties": {
          "accountId": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "displayName": { "type": "string", "maxLength": 100 },
          "emailVerified": { "type": "boolean" }
        }
      },
      "CreateAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "displayName", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
          "password": { "type": "string", "minLength": 12, "maxLength": 1024 }
        }
      },
      "CreateSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      },
      "CompleteEmailVerification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
        }
      },
      "PasswordRecoveryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 }
        }
      },
      "CompletePasswordRecovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "newPassword"],
        "properties": {
          "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "newPassword": { "type": "string", "minLength": 12, "maxLength": 1024 }
        }
      },
      "SessionCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "sessionToken", "expiresAt"],
        "properties": {
          "account": { "$ref": "#/components/schemas/Account" },
          "sessionToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "expiresAt"],
        "properties": {
          "account": { "$ref": "#/components/schemas/Account" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "Live": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "ok" } }
      },
      "Ready": {
        "type": "object",
        "required": ["status", "service"],
        "properties": {
          "status": { "const": "ready" },
          "service": { "const": "identity-go" }
        }
      }
    }
  }
}
