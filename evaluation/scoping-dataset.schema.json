{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client scoping evaluation case",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "cohort": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "properties": {
        "fictional": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "consent": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "required": ["fictional", "source", "consent", "limitations"],
      "additionalProperties": false
    },
    "brief": { "type": "string", "minLength": 1 },
    "approval": {
      "type": "object",
      "properties": {
        "status": { "enum": ["draft", "approved", "disputed"] },
        "reviewerId": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" },
        "rubricVersion": { "type": "string", "minLength": 1 },
        "independentReviewers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "adjudicationNote": { "type": ["string", "null"] }
      },
      "required": ["status", "reviewerId", "approvedAt", "rubricVersion", "independentReviewers", "adjudicationNote"],
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "requirements": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 } }, "required": ["id", "summary", "evidence"], "additionalProperties": false } },
        "missingQuestions": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 }, "question": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }, "required": ["id", "question", "reason"], "additionalProperties": false } },
        "capabilityJudgments": { "type": "array", "items": { "type": "object", "properties": { "capability": { "type": "string", "minLength": 1 }, "label": { "enum": ["supported", "unsupported", "unknown"] } }, "required": ["capability", "label"], "additionalProperties": false } }
      },
      "required": ["requirements", "missingQuestions", "capabilityJudgments"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "caseId", "domain", "cohort", "provenance", "brief", "approval", "expected"],
  "additionalProperties": false
}
