# Go-owned private record storage. Empty values keep the preview ephemeral.
DATABASE_URL=
SERVICE_TOKEN_SECRET=
# Optional active key label; defaults to `legacy` for existing deployments.
SERVICE_TOKEN_KEY_ID=
# Optional JSON map of previous key IDs to their original secret values during rotation.
SERVICE_TOKEN_VERIFICATION_KEYS=
# Both keys are independent base64 encodings of 32 random bytes.
CLIENT_CONTENT_KEY=
IDENTITY_INDEX_KEY=
RECORD_RETENTION_DAYS=90
