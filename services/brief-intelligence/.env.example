# Local source-run defaults. Docker overrides HOST to the private Compose interface.
HOST=127.0.0.1
PORT=8001
REQUEST_TIMEOUT_SECONDS=40
BRIEF_SERVICE_TOKEN_SECRET=
BRIEF_SERVICE_TOKEN_KEY_ID=
# During rotation, JSON map of old key IDs to their exact prior secret values.
BRIEF_SERVICE_TOKEN_VERIFICATION_KEYS=
OPENAI_API_KEY=
AGENT_MODEL=gpt-6.1-sol
