# Non-secret local URLs used only by the server-side BFF.
BRIEF_SERVICE_URL=http://127.0.0.1:8001
ESTIMATOR_SERVICE_URL=http://127.0.0.1:8002
PREVIEW_TIMEOUT_MS=10000

# Shared only between this server-side BFF and the Python brief service.
# Keep this distinct from SERVICE_TOKEN_SECRET and never use NEXT_PUBLIC_ names.
BRIEF_SERVICE_TOKEN_SECRET=
BRIEF_SERVICE_TOKEN_KEY_ID=

# Shared only between the Next.js BFF and the Go service. Never expose as NEXT_PUBLIC_*.
SERVICE_TOKEN_SECRET=
# Optional key label; keep `legacy` while using the original unlabelled token key.
SERVICE_TOKEN_KEY_ID=
