# Optional local AI configuration for the Python brief-intelligence service.
# Supply from an ignored local env file with: docker compose --env-file .env.local up --build
# Compose forwards this only to the Python service at runtime; never prefix with NEXT_PUBLIC_ or VITE_.
OPENAI_API_KEY=
AGENT_MODEL=gpt-6.1-sol

# Optional local first-party identity preview. Generate distinct URL-safe random values.
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_BFF_SHARED_SECRET=
WEB_PORT=3002

# Optional private-record storage. Use separate random values for all keys and passwords.
SERVICE_TOKEN_SECRET=
POSTGRES_PASSWORD=
CLIENT_CONTENT_KEY=
IDENTITY_INDEX_KEY=
RECORD_RETENTION_DAYS=90

# Optional only during explicit migration of a previous OIDC workspace.
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional legacy Site model configuration.
OPENAI_MODEL=gpt-5.4-mini
