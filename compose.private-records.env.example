# Copy these placeholders into the ignored root .env.local to enable first-party private workspaces.
# Keep any existing OPENAI_API_KEY line; do not commit populated values.
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_BFF_SHARED_SECRET=
WEB_PORT=3002
SERVICE_TOKEN_SECRET=
SERVICE_TOKEN_KEY_ID=
SERVICE_TOKEN_VERIFICATION_KEYS=
POSTGRES_PASSWORD=
CLIENT_CONTENT_KEY=
IDENTITY_INDEX_KEY=
RECORD_RETENTION_DAYS=90
# Automatic email intake polling. Server and worker must remain running.
WORKFLOW_POLL_INTERVAL_MS=300000
# Optional external HTTPS origin for OAuth callbacks and MCP Origin checks.
WORKFLOW_PUBLIC_URL=
