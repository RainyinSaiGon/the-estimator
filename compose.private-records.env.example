# Copy these placeholders into the ignored root .env.local to enable first-party private workspaces.
# Keep any existing OPENAI_API_KEY line; do not commit populated values.
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_BFF_SHARED_SECRET=
WEB_PORT=3002
SERVICE_TOKEN_SECRET=
POSTGRES_PASSWORD=
CLIENT_CONTENT_KEY=
IDENTITY_INDEX_KEY=
RECORD_RETENTION_DAYS=90

# Optional temporary legacy provider settings, used only when explicitly migrating an old workspace.
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
